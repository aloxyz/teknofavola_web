# Copy to .env and adjust before running `docker compose up`.

POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
POSTGRES_DB=teknofavola
POSTGRES_PORT=5432

DIRECTUS_PORT=8055
# Generate real random values for these two before deploying anywhere but a laptop:
#   openssl rand -hex 32
DIRECTUS_KEY=tf-local-key-change-me
DIRECTUS_SECRET=tf-local-secret-change-me

DIRECTUS_ADMIN_EMAIL=admin@teknofavola.it
DIRECTUS_ADMIN_PASSWORD=change-me-now

# Must match how the browser/SvelteKit server reach Directus.
DIRECTUS_PUBLIC_URL=http://localhost:8055

# The SvelteKit dev/prod origin, for CORS.
SITE_ORIGIN=http://localhost:5173

# Used only by bootstrap/seed scripts (never by the running site):
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=
