[Unit]
Description=TeknoFavola stack (site + Directus + Postgres + Caddy)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/admin/teknofavola_web/deploy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
User=admin
Group=admin

[Install]
WantedBy=multi-user.target
