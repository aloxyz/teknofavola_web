# Copy to .env, fill in real values, never commit it.

# Your domain — the site goes on this, Directus on admin.<this>.
DOMAIN=teknofavola.it

POSTGRES_USER=directus
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=teknofavola

# openssl rand -hex 32 (both)
DIRECTUS_KEY=
DIRECTUS_SECRET=

DIRECTUS_ADMIN_EMAIL=admin@teknofavola.it
# Used only on first boot to create the admin account — change it from the
# panel afterwards and this value stops mattering.
DIRECTUS_ADMIN_PASSWORD=

# Static token for a restricted, read-only Directus role (see directus/README.md
# "Token per il sito"). Leave empty to rely on the Public policy's read
# permissions instead — already scoped to published/active records only,
# which is what this project's bootstrap sets up.
DIRECTUS_TOKEN=

# openssl rand -hex 32
FORM_IP_SALT=
FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MS=600000
