# Copy to .env.local (dev) or set these in your hosting platform (prod).

# Server-to-server Directus URL (can be an internal docker hostname, e.g.
# http://directus:8055 when this app and Directus run in the same compose
# network). Never exposed to the browser.
DIRECTUS_URL=http://localhost:8055

# Static token for a restricted, READ-ONLY Directus role scoped to the
# public-facing collections. Never use the admin token here.
DIRECTUS_TOKEN=

# Browser-facing Directus URL, used to build <img>/asset links. Must be
# reachable from visitors' browsers (e.g. https://admin.teknofavola.it).
PUBLIC_DIRECTUS_URL=http://localhost:8055

# Used to build absolute URLs in sitemap.xml/robots.txt.
PUBLIC_SITE_ORIGIN=http://localhost:5173

# Form abuse controls (see src/routes/api/submit/+server.ts).
FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MS=600000
FORM_IP_SALT=change-me-to-a-random-string
